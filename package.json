{
  "name": "@edgeproc/errors",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "Canonical error glue: register a per-app catalog, classify raw failures into stable codes, describe via your own i18next, serialize to RFC 9457 Problem Details. Zero runtime deps.",
  "license": "MIT",
  "author": "Harish Seshadri",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "demo": "pnpm build && node examples/quickstart.mjs",
    "gate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.7"
  }
}
