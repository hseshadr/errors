  "cards": [
    {
      "dot": "cyan",
      "title": "Thin integration layer",
      "items": [
        "Zero runtime dependencies and no hosted service or hidden global registry",
        "Applications compose only the catalog fragments and domain codes they need"
      ]
    },
    {
      "dot": "emerald",
      "title": "Deterministic classification",
      "items": [
        "Priority matchers run first, then exact status, status range, and registered fallback",
        "Duplicate codes and invalid configured fallbacks fail at registry construction"
      ]
    },
    {
      "dot": "amber",
      "title": "Consumer-owned behavior",
      "items": [
        "The package classifies and serializes; the application owns logging, retries, reporting, and UI policy",
        "Human text comes from the app translation function with catalog English as fallback"
      ]
    }
  ]
